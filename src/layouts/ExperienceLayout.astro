---
// src/layouts/ExperienceLayout.astro
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'experiences'>['data'];

const { title, description, pubDate, updatedDate, location, role, heroImage, gallery, links } =
	Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage} width="wide">
	<article class="experience-detail">
		{
			heroImage && (
				<Image
					width={1020}
					height={510}
					src={heroImage}
					alt={`Hero image for ${title}`}
					class="hero-image"
				/>
			)
		}

		<header class="experience-header">
			<h1>{title}</h1>
			<p class="meta">
				{location} &middot; <FormattedDate date={pubDate} />
			</p>
			{role && <p class="meta role">{role}</p>}
			{
				updatedDate && (
					<p class="meta last-updated-on">
						Last updated on <FormattedDate date={updatedDate} />
					</p>
				)
			}
		</header>

		<div class="prose">
			<slot />
			{
				gallery && gallery.length > 0 && (
					<div class="gallery">
						{gallery.map((photo) => (
							<figure>
								<Image width={720} height={480} src={photo.src} alt={photo.alt} />
								{photo.caption && <figcaption>{photo.caption}</figcaption>}
							</figure>
						))}
					</div>
				)
			}
			{
				links && links.length > 0 && (
					<section class="related-links">
						<h2>Related Links</h2>
						<ul>
							{links.map((link) => (
								<li>
									<a href={link.url} target="_blank" rel="noopener noreferrer">
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</div>
	</article>
</BaseLayout>

<style>
	/* Structure mirrors ProjectLayout so experiences and projects read alike */
	.experience-detail {
		margin: auto;
	}
	.hero-image {
		display: block;
		width: 100%;
		height: auto;
		max-height: 450px;
		object-fit: cover;
		border-radius: var(--radius-lg);
		margin-bottom: 2rem;
		box-shadow: var(--shadow-md);
	}
	.experience-header {
		text-align: center;
		margin-bottom: 3rem;
	}
	.experience-header h1 {
		margin-bottom: 1rem;
	}
	.experience-header h1::after {
		content: '';
		display: block;
		width: 64px;
		height: 4px;
		border-radius: 2px;
		background: var(--accent-gradient);
		margin: 0.85rem auto 0;
	}
	.experience-header .meta {
		font-size: 1.1rem;
		color: var(--muted-color);
		margin: 0 0 0.25rem 0;
	}
	.experience-header .role {
		font-weight: 700;
	}
	.last-updated-on {
		font-style: italic;
	}

	/* Main content styles (same as ProjectLayout) */
	.prose {
		color: var(--font-color);
	}
	.prose :global(h2) {
		font-size: 2rem;
		margin-top: 3rem;
		margin-bottom: 1.5rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid rgba(var(--shadow-color), 0.2);
	}
	.prose :global(h3) {
		font-size: 1.5rem;
		margin-top: 2rem;
		margin-bottom: 1rem;
	}
	.prose :global(p) {
		font-size: 1.1rem;
		line-height: 1.8;
		margin-bottom: 1.5em;
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 2em;
		margin-bottom: 1.5em;
		font-size: 1.1rem;
		line-height: 1.8;
	}
	.prose :global(li) {
		margin-bottom: 0.75em;
	}
	.prose :global(strong) {
		color: var(--accent-dark);
		font-weight: 700;
	}

	.gallery {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		margin: 2rem 0;
	}
	@media (min-width: 768px) {
		.gallery {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	.gallery figure {
		margin: 0;
	}
	.gallery img {
		width: 100%;
		height: auto;
		border-radius: 8px;
		box-shadow: 0 4px 12px rgba(var(--shadow-color), 0.15);
	}
	.gallery figcaption {
		margin-top: 0.5rem;
		font-size: 0.9rem;
		color: var(--muted-color);
	}
	.related-links {
		margin-top: 3rem;
	}
</style>
